+{% extends 'index.html' %}
+{% block title %}User Invitations{% endblock %}
+{% block content %}
+<div class="d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-center mb-4">
+  <div><h1 class="h2 mb-1">User invitations</h1><p class="text-secondary mb-0">Invite pilots to create an AirSpace account.</p></div>
+</div>
+<div class="card border-0 shadow-sm rounded-4 mb-4"><div class="card-body p-4">
+<form method="post" class="row g-3 align-items-end">{% csrf_token %}<div class="col-12 col-md-8">{{ form.email.label_tag }}{{ form.email }}{% for error in form.email.errors %}<div class="invalid-feedback d-block">{{ error }}</div>{% endfor %}</div><div class="col-12 col-md-4"><button class="btn btn-dark w-100">Send invitation</button></div></form>
+</div></div>
+<div class="card border-0 shadow-sm rounded-4"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Email</th><th>Status</th><th>Sent</th><th>Expires</th><th class="text-end">Actions</th></tr></thead><tbody>
+{% for invitation in invitations %}<tr><td>{{ invitation.email }}</td><td><span class="badge text-bg-{% if invitation.display_status == 'accepted' %}success{% elif invitation.display_status == 'revoked' or invitation.display_status == 'expired' %}secondary{% else %}warning{% endif %}">{{ invitation.display_status|title }}</span></td><td>{{ invitation.sent_at|date:"M j, Y g:i A"|default:"Not sent" }}</td><td>{{ invitation.expires_at|date:"M j, Y g:i A" }}</td><td class="text-end"><div class="d-inline-flex gap-2">{% if invitation.status == 'pending' %}<form method="post" action="{% url 'accounts:invitation_resend' invitation.pk %}">{% csrf_token %}<button class="btn btn-sm btn-outline-dark">Resend</button></form><form method="post" action="{% url 'accounts:invitation_revoke' invitation.pk %}">{% csrf_token %}<button class="btn btn-sm btn-outline-danger">Revoke</button></form>{% endif %}</div></td></tr>{% empty %}<tr><td colspan="5" class="text-center py-4 text-secondary">No invitations yet.</td></tr>{% endfor %}
+</tbody></table></div></div>
+{% endblock %}
